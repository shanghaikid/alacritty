+/* Keep an empty mouse anchor separate from the application input cursor. */
+struct screen *
+window_copy_cursor_screen(struct window_pane *wp, u_int *cx, u_int *cy)
+{
+	struct window_mode_entry		*wme = TAILQ_FIRST(&wp->modes);
+	struct window_copy_mode_data	*data;
+	struct options_entry		*o;
+
+	*cx = wp->screen->cx;
+	*cy = wp->screen->cy;
+	if (wme == NULL || wme->mode != &window_copy_mode)
+		return (wp->screen);
+	data = wme->data;
+	o = options_get(wp->options, "@alacritty_mouse_anchor");
+	if (o == NULL || strcmp(options_get_string(wp->options,
+	    "@alacritty_mouse_anchor"), "1") != 0 ||
+	    data->screen.sel == NULL || data->cursordrag != CURSORDRAG_NONE ||
+	    data->selx != data->endselx || data->sely != data->endsely ||
+	    wme->swp != wp)
+		return (wp->screen);
+
+	/* The backing cursor belongs to the text frozen by copy mode. */
+	*cx = data->backing->cx;
+	/* A pending wrap still displays the cursor on the last cell. */
+	if (*cx == screen_size_x(data->backing))
+		(*cx)--;
+	*cx += window_copy_line_number_width(wme);
+	*cy = data->backing->cy + data->oy;
+	return (&wp->base);
+}
